        <biz:DocumentID><replace param="order_id" /></biz:DocumentID>
        <biz:OrderDate>2026-10-15T08:30:00Z</biz:OrderDate>
        <biz:Status>APPROVED</biz:Status>
    </biz:Header>
    <biz:Customer>
        <cmn:Identifier>CUST-99281</cmn:Identifier>
        <cmn:Name>
            <cmn:FullName><replace param="cust_fullname" /></cmn:FullName>
        </cmn:Name>
        <cmn:Contact>
            <cmn:Email><replace param="cust_email" /></cmn:Email>
